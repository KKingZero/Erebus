server: "127.0.0.1:50051"
cert: "~/.erebus/certs/operator.pem"
key: "~/.erebus/certs/operator-key.pem"
ca: "~/.erebus/certs/ca.pem"
llm:
  # Console `ai` uses ~/.erebus/llm.yaml (multi-provider). Override here for agent sidecar only.
  base_url: "http://localhost:11434/v1"
  api_key: "ollama"
  model: "llama3.2"
autonomy:
  max_steps: 50
  auto_approve: false